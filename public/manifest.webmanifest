{
    "name": "MiniTally Billing",
    "short_name": "MiniTally",
    "description": "Month-end billing, payments and reminders",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#f1f5f9",
    "theme_color": "#34467c",
    "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
        { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Add entries", "url": "/entries/create", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Outstanding", "url": "/outstanding", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
    ]
}
